{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "nix": {
    "enabled": true
  },
  "flux": {
    "enabled": true,
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "enabled": true,
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "github-actions": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions annotated with a renovate comment in CI",
      "managerFilePatterns": ["/^\\.github/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+[A-Za-z0-9_-]+?\\s*[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Grafana image pinned in a Helm values ConfigMap, which the flux manager cannot see",
      "managerFilePatterns": ["/^kubernetes/infrastructure/controllers/.+/configmap-values\\.ya?ml$/"],
      "matchStrings": ["grafana:[\\s\\S]*?\\n\\s+image:\\s*\\n\\s+tag:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the CRD schema catalog commit pinned for kubeconform",
      "managerFilePatterns": ["/^\\.github/actions/manifest-tools/action\\.yml$/"],
      "matchStrings": ["CRDS_CATALOG_COMMIT:\\s*(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "https://github.com/datreeio/CRDs-catalog",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Update the base image and plugin pins in the Packer templates",
      "managerFilePatterns": ["/^infra/packer/.+\\.pkr\\.hcl$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s+[A-Za-z0-9_-]+?\\s*=\\s*\"[a-z]+-(?<currentValue>[^\"\\s]+)\"",
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: extractVersion=(?<extractVersion>\\S+?))?\\s+version\\s*=\\s*\"=\\s*(?<currentValue>[^\"\\s]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update the nixos-anywhere flake reference used by Packer",
      "managerFilePatterns": ["/^infra/packer/.+\\.pkr\\.hcl$/"],
      "matchStrings": ["github:nix-community/nixos-anywhere\\?ref=(?<currentValue>[^'\"\\s]+)"],
      "depNameTemplate": "nix-community/nixos-anywhere",
      "datasourceTemplate": "github-tags"
    }
  ],
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Flux image automation owns the blog image tag",
      "matchFileNames": ["kubernetes/apps/blog/app/deployment.yaml"],
      "enabled": false
    },
    {
      "description": "Group all nixpkgs flake updates together",
      "matchManagers": ["nix"],
      "groupName": "nixpkgs"
    },
    {
      "description": "Read MinIO's dated RELEASE tags, which no built-in versioning parses",
      "matchPackageNames": ["quay.io/minio/minio"],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>.+)$"
    },
    {
      "description": "Group infrastructure Helm charts together",
      "matchManagers": ["flux"],
      "groupName": "infrastructure charts",
      "schedule": ["on sunday"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/cert-manager/",
        "/traefik/",
        "/longhorn/",
        "/kube-prometheus-stack/"
      ]
    },
    {
      "description": "Auto-merge minor, patch, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Hold major updates for manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Hold critical infrastructure minors and patches for manual review",
      "matchManagers": ["flux", "kubernetes"],
      "matchPackageNames": [
        "/^longhorn$/",
        "/^cloudnative-pg$/",
        "/^kube-prometheus-stack$/",
        "/^cert-manager$/",
        "/^traefik$/",
        "/^authentik$/",
        "/^rancher$/",
        "/^metallb$/",
        "/^minio$/",
        "/^flux-operator$/",
        "/^kyverno$/",
        "/^loki$/",
        "/^tempo$/",
        "/^alloy$/",
        "/^paperless-ngx$/",
        "/^flagger$/",
        "/^quay\\.io\\/minio\\/minio$/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Hold the node image inputs, since a bump rebuilds the snapshot",
      "matchFileNames": ["infra/packer/**"],
      "automerge": false
    },
    {
      "description": "Step stateful infrastructure one minor at a time",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "/^longhorn$/",
        "/^cloudnative-pg$/",
        "/^kube-prometheus-stack$/",
        "/^cert-manager$/"
      ],
      "separateMultipleMinor": true
    }
  ]
}
