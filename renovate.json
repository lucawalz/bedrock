{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests"
  ],
  "nix": {
    "description": "Keep the beta nix manager opted in, since Renovate ships it disabled",
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "minimumReleaseAge": null
    }
  },
  "flux": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versions annotated with a renovate comment in CI",
      "managerFilePatterns": ["/^\\.github/.+\\.ya?ml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+[A-Za-z0-9_-]+?\\s*[:=]\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Update the Grafana image pinned in a Helm values ConfigMap, which the flux manager cannot see",
      "managerFilePatterns": ["/^kubernetes/infrastructure/controllers/.+/configmap-values\\.ya?ml$/"],
      "matchStrings": ["grafana:[\\s\\S]*?\\n\\s+image:\\s*\\n\\s+tag:\\s*\"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?\""],
      "depNameTemplate": "grafana/grafana",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update an annotated image tag and digest in HelmRelease values that the flux manager cannot read",
      "managerFilePatterns": ["/^kubernetes/.+/helmrelease\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+tag:\\s*\"?(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"?",
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)\\s+tag:\\s*\"?(?<currentValue>[^\"@\\s]+)\"?\\s+digest:\\s*\"?(?<currentDigest>sha256:[0-9a-f]{64})\"?"
      ]
    },
    {
      "customType": "regex",
      "description": "Track the CRD schema catalog commit pinned for kubeconform",
      "managerFilePatterns": ["/^\\.github/actions/manifest-tools/action\\.yml$/"],
      "matchStrings": ["CRDS_CATALOG_COMMIT:\\s*(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "https://github.com/datreeio/CRDs-catalog",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "main"
    },
    {
      "customType": "regex",
      "description": "Update the base image and plugin pins in the Packer templates",
      "managerFilePatterns": ["/^infra/packer/.+\\.pkr\\.hcl$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?\\s+[A-Za-z0-9_-]+?\\s*=\\s*\"[a-z]+-(?<currentValue>[^\"\\s]+)\"",
        "#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+?)(?: extractVersion=(?<extractVersion>\\S+?))?\\s+version\\s*=\\s*\"=\\s*(?<currentValue>[^\"\\s]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Track the Flux minor line pinned on the FluxInstance distribution",
      "managerFilePatterns": ["/^kubernetes/clusters/home/flux-operator/instance/fluxinstance\\.yaml$/"],
      "matchStrings": ["version:\\s*\"(?<currentValue>\\d+\\.\\d+)\\.x\""],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+)\\.\\d+$",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "version: \"{{{newValue}}}.x\""
    },
    {
      "customType": "regex",
      "description": "Update the nixos-anywhere flake reference used by Packer",
      "managerFilePatterns": ["/^infra/packer/.+\\.pkr\\.hcl$/"],
      "matchStrings": ["github:nix-community/nixos-anywhere\\?ref=(?<currentValue>[^'\"\\s]+)"],
      "depNameTemplate": "nix-community/nixos-anywhere",
      "datasourceTemplate": "github-tags"
    }
  ],
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Group all nixpkgs flake updates together",
      "matchManagers": ["nix"],
      "groupName": "nixpkgs"
    },
    {
      "description": "Update the infrastructure charts and their images on Sundays",
      "matchManagers": ["flux"],
      "schedule": ["on sunday"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/cert-manager/",
        "/traefik/",
        "/longhorn/",
        "/kube-prometheus-stack/"
      ]
    },
    {
      "description": "Ship a chart and the images pinned in its HelmRelease values in one pull request",
      "matchFileNames": ["kubernetes/**/helmrelease.yaml"],
      "groupName": "{{{packageFileDir}}}"
    },
    {
      "description": "Let images from registries that publish no release timestamp pass the release age wait",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Keep OCI chart references on their version, since a HelmRelease chart takes no digest",
      "matchDepTypes": ["HelmChart"],
      "pinDigests": false
    },
    {
      "description": "Auto-merge minor, patch, and digest updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "automerge": true
    },
    {
      "description": "Hold critical infrastructure minors and patches for manual review",
      "matchManagers": ["flux", "kubernetes", "custom.regex"],
      "matchPackageNames": [
        "/^longhorn$/",
        "/^docker\\.io/longhornio//",
        "/^ghcr\\.io/cloudnative-pg/(cloudnative-pg|plugin-barman-cloud|plugin-barman-cloud-sidecar)$/",
        "/^quay\\.io/prometheus(-operator)?//",
        "/^registry\\.k8s\\.io/kube-state-metrics/kube-state-metrics$/",
        "/^quay\\.io/kiwigrid/k8s-sidecar$/",
        "/^quay\\.io/jetstack/cert-manager-/",
        "/^docker\\.io/traefik$/",
        "/^quay\\.io/oauth2-proxy/oauth2-proxy$/",
        "/^quay\\.io/metallb//",
        "/^quay\\.io/frrouting/frr$/",
        "/^ghcr\\.io/controlplaneio-fluxcd/flux-operator$/",
        "/^reg\\.kyverno\\.io/kyverno//",
        "/^docker\\.io/grafana/(loki|tempo|alloy)$/",
        "/^ghcr\\.io/fluxcd/flagger$/",
        "/^fluxcd/flux2$/",
        "/^ghcr\\.io/kyverno/readiness-checker$/",
        "/^ghcr\\.io/jkroepke/kube-webhook-certgen$/",
        "/^cloudnative-pg$/",
        "/^plugin-barman-cloud$/",
        "/^kube-prometheus-stack$/",
        "/^cert-manager$/",
        "/^traefik$/",
        "/^traefik-crds$/",
        "/^prometheus-operator-crds$/",
        "/^oauth2-proxy$/",
        "/^ghcr\\.io/pocket-id/pocket-id$/",
        "/^python$/",
        "/^metallb$/",
        "/^flux-operator$/",
        "/^kyverno$/",
        "/^loki$/",
        "/^tempo$/",
        "/^alloy$/",
        "/(^|/)paperless-ngx$/",
        "/(^|/)paperless-gpt$/",
        "/(^|/)litellm$/",
        "/(^|/)open-webui$/",
        "/(^|/)ntfy$/",
        "/(^|/)cloudflared$/",
        "/(^|/)zot$/",
        "/^flagger$/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Hold the node image inputs, since a bump rebuilds the snapshot",
      "matchFileNames": ["infra/packer/**"],
      "automerge": false
    },
    {
      "description": "Step stateful infrastructure one minor at a time",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "/^longhorn$/",
        "/^cloudnative-pg$/",
        "/^kube-prometheus-stack$/",
        "/^cert-manager$/"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "Ship traefik-crds in the same PR as traefik, held for review",
      "matchManagers": ["flux"],
      "matchPackageNames": ["/^traefik$/", "/^traefik-crds$/", "/^docker\\.io/traefik$/"],
      "groupName": "traefik and its crds",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "description": "Ship prometheus-operator-crds with kube-prometheus-stack, whose operator minor is the crds major",
      "matchManagers": ["flux"],
      "matchPackageNames": [
        "/^kube-prometheus-stack$/",
        "/^prometheus-operator-crds$/",
        "/^quay\\.io/prometheus(-operator)?//",
        "/^registry\\.k8s\\.io/kube-state-metrics/kube-state-metrics$/",
        "/^quay\\.io/kiwigrid/k8s-sidecar$/",
        "/^docker\\.io/library/busybox$/",
        "/^ghcr\\.io/jkroepke/kube-webhook-certgen$/"
      ],
      "groupName": "kube-prometheus-stack and its crds",
      "separateMajorMinor": false,
      "automerge": false
    },
    {
      "description": "Deploy every blog build, ordered by its build timestamp, without review",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/lucawalz/blog"],
      "versioning": "regex:^main-(?<major>\\d{14})-[0-9a-f]+$",
      "minimumReleaseAge": null,
      "automerge": true
    }
  ]
}
