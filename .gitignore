# Nix build results
result
result-*

# Flakes
.flake/

# direnv
.direnv/
.envrc.local

# Terraform
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.backup
**/terraform.tfvars

# Secrets (backup - these should already be encrypted)
*.age
*.sops.yaml
!secrets/secrets.nix
!secrets/**/*.age
!kubernetes/**/bootstrap-secrets/**/*.sops.yaml
# the leading glob also matches the sops config itself, which holds only public recipients
!.sops.yaml

